<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Core Palette -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand / Accent -->
    <color name="accent_blue">#FF4F8EF7</color>
    <color name="accent_blue_dim">#1A4F8EF7</color>
    <color name="accent_purple">#FF7B5EA7</color>
    <color name="accent_purple_dim">#1A7B5EA7</color>

    <!-- Backgrounds (dark layers) -->
    <color name="bg_base">#FF0A0C10</color>
    <color name="bg_surface">#FF111318</color>
    <color name="bg_surface2">#FF181C24</color>
    <color name="bg_surface3">#FF1E2330</color>

    <!-- Borders -->
    <color name="border_subtle">#FF1E2330</color>
    <color name="border_medium">#FF2A3040</color>
    <color name="border_strong">#FF3A4560</color>

    <!-- Text -->
    <color name="text_primary">#FFF0F4FF</color>
    <color name="text_secondary">#FF9CA3AF</color>
    <color name="text_muted">#FF6B7280</color>
    <color name="text_disabled">#FF374151</color>

    <!-- Semantic -->
    <color name="status_online">#FF22C55E</color>
    <color name="status_online_dim">#1A22C55E</color>
    <color name="status_online_border">#4D22C55E</color>
    <color name="status_offline">#FFEF4444</color>
    <color name="status_offline_dim">#1AEF4444</color>
    <color name="status_offline_border">#4DEF4444</color>
    <color name="status_warning">#FFF59E0B</color>
    <color name="status_warning_dim">#1AF59E0B</color>

    <!-- Terminal -->
    <color name="terminal_bg">#FF0D0F14</color>
    <color name="terminal_green">#FF22C55E</color>
    <color name="terminal_blue">#FF4F8EF7</color>
    <color name="terminal_amber">#FFF59E0B</color>
    <color name="terminal_muted">#FF4B5563</color>
    <color name="terminal_ts">#FF374151</color>

    <!-- Material aliases (used by theme) -->
    <color name="primary">@color/accent_blue</color>
    <color name="on_primary">@color/white</color>
    <color name="primary_container">#FF1A2A4A</color>
    <color name="on_primary_container">@color/accent_blue</color>
    <color name="secondary">@color/accent_purple</color>
    <color name="on_secondary">@color/white</color>
    <color name="secondary_container">#FF2A1A3A</color>
    <color name="on_secondary_container">@color/accent_purple</color>
    <color name="background">@color/bg_base</color>
    <color name="on_background">@color/text_primary</color>
    <color name="surface">@color/bg_surface</color>
    <color name="on_surface">@color/text_primary</color>
    <color name="surface_variant">@color/bg_surface2</color>
    <color name="on_surface_variant">@color/text_secondary</color>
    <color name="outline">@color/border_medium</color>
    <color name="outline_variant">@color/border_subtle</color>
    <color name="error">#FFEF4444</color>
    <color name="success">@color/status_online</color>
    <color name="on_error">@color/white</color>
    <color name="error_container">#1AEF4444</color>

</resources>
